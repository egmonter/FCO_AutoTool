def navigate_bios_menu(s: SVOSSession, target: str, max_steps: int = BIOS_NAV_MAX,
                       arrow_delay: float = 1.0):
    """
    Navega el menu BIOS con flechas abajo buscando `target` como item RESALTADO.
    EDK2 resalta el item activo con el color ANSI ESC[37mESC[40m (blanco sobre negro).
    Cuando lo encuentra: espera 1s y da Enter.
    Lanza FCOStepError si no lo encuentra en max_steps intentos.
    """
    for attempt in range(max_steps):
        raw, _ = s.read_screen(wait=0.5)
        highlighted = _highlighted_items(raw)
        _status(f'Intento {attempt+1}/{max_steps} - resaltado: {highlighted}', 'wait')

        if any(target in h for h in highlighted):
            _status(f'"{target}" esta resaltado -> Enter en 1s', 'ok')
            time.sleep(1.0)
            s.send_enter()
            time.sleep(0.5)
            return

        s.send_arrow_down()
        time.sleep(arrow_delay)

    raise FCOStepError(f'No se encontro "{target}" resaltado en el menu BIOS tras {max_steps} intentos.')


BIOS_NAV_RETRIES = 5  # maximos reintentos con ESC antes de rendirse


def boot_svos(s: SVOSSession):
    """
    Secuencia completa de arranque:
      BIOS (OAKSTREAM) -> Boot Manager Menu -> UEFI Internal Shell
      -> FS0: -> \\efi\\boot\\BootSvosDMR.efi -> ENTER (ATTENTION) -> mountsv
    """
    # 1. Esperar pantalla BIOS (el sistema necesita tiempo para reiniciarse)
    _status(f'Esperando reinicio del sistema ({BIOS_REBOOT_WAIT}s)...', 'wait')
    time.sleep(BIOS_REBOOT_WAIT)
    s.flush()  # limpiar buffer acumulado durante el reinicio

    _status('Buscando pantalla BIOS...', 'wait')
    try:
        _, buf = s.read_until_any(BIOS_BANNERS, timeout=BIOS_WAIT_TIMEOUT)
    except TimeoutError:
        raise BiosTimeoutError(f'Pantalla BIOS no aparecio en {BIOS_WAIT_TIMEOUT}s ({BIOS_WAIT_TIMEOUT//60} min)')
    _status('BIOS detectado.', 'ok')
    time.sleep(1)

    # 2+3. Navegar Boot Manager Menu -> UEFI Internal Shell con retry via ESC
    for nav_retry in range(BIOS_NAV_RETRIES):
        try:
            _status(f'Buscando Boot Manager Menu (intento {nav_retry+1}/{BIOS_NAV_RETRIES})...', 'wait')
            navigate_bios_menu(s, BIOS_BOOT_MGR, arrow_delay=1.0)

            # Verificar que entramos a Boot Manager Menu y no a otro menu (ej. Boot Maintenance Manager)
            time.sleep(1.0)
            raw, screen_text = s.read_screen(wait=1.0)
            if 'Maintenance' in screen_text and 'Boot Manager Menu' not in screen_text:
                _status('Entramos a Boot Maintenance Manager por error. Enviando ESC...', 'warn')
                s.send_escape()
                time.sleep(1.5)
                continue  # reintentar desde el top del loop
            _status('Dentro de Boot Manager Menu.', 'ok')

            _status(f'Buscando UEFI Internal Shell...', 'step')
            navigate_bios_menu(s, BIOS_INT_SHELL, arrow_delay=1.0)
            _status('UEFI Internal Shell seleccionado.', 'ok')
            break  # exito, salir del retry loop

        except FCOStepError as e:
            if nav_retry < BIOS_NAV_RETRIES - 1:
                _status(f'No encontrado ({e}). ESC y reintentando...', 'warn')
                s.send_escape()
                time.sleep(1.5)
            else:
                raise FCOStepError(
                    f'No se pudo navegar el BIOS tras {BIOS_NAV_RETRIES} intentos. '
                    f'Ultimo error: {e}')

    # 4. Esperar EFI Shell prompt
    _status('Esperando EFI Shell...', 'wait')
    with _guard('EFI Shell prompt'):
        s.read_until_any(EFI_PROMPTS, timeout=BOOT_TIMEOUT)
    _status('EFI Shell listo.', 'ok')

    # 5. Buscar BootSVOS.efi en FS0, FS1, FS2
    booted = False
    for fs in ('FS0', 'FS1', 'FS2'):
        _status(f'Intentando {fs}: ...', 'step')
        s.flush()
        s.send(f'{fs}:')
        try:
            s.read_until(f'{fs}:\\', timeout=15)
        except TimeoutError:
            _status(f'{fs}: no disponible, probando siguiente...', 'info')
            continue

        _status(f'Lanzando \\efi\\boot\\BootSvosDMR.efi desde {fs}: ...', 'step')
        s.send_slow('\\efi\\boot\\BootSvosDMR.efi', char_delay=0.05)

        # Si el archivo NO existe: el EFI shell devuelve el prompt en < 5s
        # Si el archivo SI existe: no hay respuesta por varios segundos mientras carga
        # -> Esperamos 10s el prompt del shell; si no llega = esta cargando
        ATTENTION  = b'Press <ENTER> within 10 seconds to drop to a login shell'
        EFI_PROMPT = [b'Shell>', b'shell>', f'{fs}:\\'.encode(), f'{fs}:/'.encode()]
        try:
            matched, _ = s.read_until_any([ATTENTION] + EFI_PROMPT, timeout=10)
            if matched == ATTENTION:
                booted = True
                break
            else:
                # El shell devolvio el prompt = archivo no encontrado
                _status(f'BootSvosDMR.efi no encontrado en {fs}: (prompt volvio rapido), probando siguiente...', 'info')
                continue
        except TimeoutError:
            # Sin prompt en 10s = el archivo cargo y esta arrancando, esperar sin limite
            _status(f'BootSvosDMR.efi cargando en {fs}:, esperando ATTENTION sin limite...', 'wait')
            s.read_until(ATTENTION.decode(), timeout=None)
            booted = True
            break

    if not booted:
        raise FCOStepError(
            'No se encontro \\efi\\boot\\BootSvosDMR.efi en FS0:, FS1: ni FS2:. '
            'Verifica que el filesystem este disponible.')

    _status('Mensaje ATTENTION detectado. Enviando ENTER...', 'step')
    s.send_enter()

    # 7. Esperar el primer root@sut:/> (shell temporal post-ATTENTION)
    _status('Cargando SVOS...', 'wait')
    with _guard('shell SVOS post-boot (root@sut:/>)'):
        s.read_until(SVOS_PROMPT, timeout=SVOS_TIMEOUT)
    _status('Shell temporal listo. Ejecutando login...', 'step')
    s.send('login')

    # 8. Login: esperar "sut login:", enviar usuario y clave
    with _guard('prompt "sut login:" - verifica que SVOS cargo correctamente'):
        s.read_until('sut login:', timeout=30)
    _status('Ingresando usuario: root', 'step')
    s.send('root')

    with _guard('prompt "Password:"'):
        s.read_until_any(['Password:', 'password:'], timeout=30)
    _status('Ingresando password...', 'step')
    s.send('svos')

    # 9. Esperar prompt root@sut:/> (sesion autenticada)
    with _guard('login exitoso - verifica usuario/clave (root/svos)'):
        s.read_until(SVOS_PROMPT, timeout=30)
    _status('Login exitoso. SVOS shell listo (root@sut:/>).', 'ok')

    _pause('Login OK — valida en Raritan y presiona cualquier tecla para ejecutar mountsv...')

    # 10. Ejecutar mountsv y esperar que vuelva el prompt
    _status('Ejecutando mountsv...', 'step')
    s.send('mountsv')
    try:
        s.read_until(SVOS_PROMPT, timeout=MOUNTSV_TIMEOUT)
    except TimeoutError:
        raise MountsvTimeoutError(f'mountsv no respondio en {MOUNTSV_TIMEOUT//60} min')
    _status('mountsv completado. SVOS montado correctamente.', 'ok')


