def _self_update():
    """
    Sincroniza todos los archivos del IDrive al directorio local antes de iniciar.
    Excluye las carpetas logs/, signals/ y __pycache__.
    Si svos_automation.py fue reemplazado, relanza el proceso con los mismos
    argumentos para que la version nueva sea la que corra.
    """
    import shutil

    SKIP_DIRS  = {'logs', '__pycache__'}
    SKIP_EXTS  = {'.pyc', '.log'}

    if not IDRIVE_SOURCE.exists():
        print(f'  [update] IDrive no accesible ({IDRIVE_SOURCE}), saltando actualizacion.')
        return

    # Limpiar signals locales para garantizar fresh run
    if SIGNAL_DIR.exists():
        removed = [f for f in SIGNAL_DIR.iterdir()
                   if f.is_file() and f.suffix in {'.signal', '.json'}]
        for f in removed:
            f.unlink()
        if removed:
            print(f'  [update] {len(removed)} signal(s) anterior(es) eliminada(s).')

    self_was_updated = False
    updated = []

    for src in IDRIVE_SOURCE.rglob('*'):
        if src.is_dir():
            continue
        rel = src.relative_to(IDRIVE_SOURCE)
        # Saltar carpetas excluidas
        if any(part in SKIP_DIRS for part in rel.parts):
            continue
        # Saltar extensiones excluidas
        if src.suffix.lower() in SKIP_EXTS:
            continue

        dst = BASE_DIR / rel
        # Copiar si el archivo no existe o el del IDrive es mas nuevo
        if not dst.exists() or src.stat().st_mtime > dst.stat().st_mtime:
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, dst)
            updated.append(str(rel))
            if rel.name == 'svos_automation.py':
                self_was_updated = True

    if updated:
        print(f'  [update] {len(updated)} archivo(s) actualizado(s): {", ".join(updated)}')
    else:
        print(f'  [update] Todo al dia ({IDRIVE_SOURCE.name}).')

    if self_was_updated:
        print('  [update] svos_automation.py fue actualizado — relanzando version nueva...')
        import subprocess
        subprocess.Popen([sys.executable] + sys.argv)
        sys.exit(0)


def _update_readme():
    """Actualiza las rutas en README.txt con el path real donde esta el script.
    Usa regex para reemplazar siempre, sin depender de un placeholder fijo."""
    import re
    readme = BASE_DIR / 'README.txt'
    if not readme.exists():
        return
    try:
        path_str = str(BASE_DIR)
        content  = readme.read_text(encoding='utf-8')

        # Linea:  cd <cualquier ruta>\fco_automation  o  cd <placeholder>
        content = re.sub(
            r'(  cd )(.+)',
            lambda m: m.group(1) + path_str,
            content
        )
        # Linea:  sys.path.insert(0, r'<cualquier ruta>')
        content = re.sub(
            r"(  sys\.path\.insert\(0, r')([^']+)(')",
            lambda m: m.group(1) + path_str + m.group(3),
            content
        )
        readme.write_text(content, encoding='utf-8')
    except Exception:
        pass  # No es critico, no interrumpir la ejecucion

