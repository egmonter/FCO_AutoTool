def _ask_qdf_params(label=''):
    """Pide QDFs, ULT, SOC, extra_args. Retorna (qdfs, ult0, soc, extra_args).
    label: texto adicional para el prompt, ej: '(QDF fuseado)' o '(QDFs a overwritear)'"""
    label_str = f' {label}' if label else ''
