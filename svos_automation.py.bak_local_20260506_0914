def run_fused_test(s: SVOSSession, qdf: str, ult0: str, week: str, ifwi: str, content=None):
    """Corre el flujo SVOS standalone para un QDF fuseado (sin senales de SV).
    Retorna (log_path, overall, results)."""
    t0_boot = time.time()
    boot_svos(s)
    setup_fco_dir(s, qdf, week)
    if CRONOS_MODE:
        _timings.setdefault(qdf, {})['boot'] = time.time() - t0_boot

    results = {}

    def _run_safe(name, fn, *args, _tkey=None):
        """Corre un test, captura cualquier fallo y lo reporta como FAIL."""
        t0 = time.time()
        try:
            result = fn(*args)
        except Exception as e:
            _status(f'{name} FALLO: {e}', 'fail')
            logging.error(f'{name} fallo para {qdf}: {e}', exc_info=True)
            result = 'FAIL'
        if CRONOS_MODE and _tkey:
            _timings.setdefault(qdf, {})[_tkey] = time.time() - t0
        return result

    if _should_run(content, 'supercollider'):
        results['supercollider'] = _run_safe('SuperCollider', run_supercollider, s,
                                             _tkey='supercollider')
    else:
        results['supercollider'] = 'SKIPPED'

    if _should_run(content, 'rocket'):
        rocket_res = _run_safe('Rocket cpu/iax', run_rocket, s, _tkey='rocket_cpu_iax')
        if isinstance(rocket_res, dict):
            results.update(rocket_res)
        else:
            for _, label in ROCKET_CMDS:
                results[label] = 'FAIL'
    else:
        for _, label in ROCKET_CMDS:
            results[label] = 'SKIPPED'

    results['memicals'] = (_run_safe('Memicals', run_memicals, s, _tkey='memicals')
                           if _should_run(content, 'memicals') else 'SKIPPED')
    results['mlc']      = (_run_safe('MLC', run_mlc, s, _tkey='mlc')
                           if _should_run(content, 'mlc')      else 'SKIPPED')
    results['solar']    = (_run_safe('Solar', run_solar, s, _tkey='solar')
                           if _should_run(content, 'solar')    else 'SKIPPED')

    if _should_run(content, 'rocket'):
        results['rocket_dram_dsa'] = _run_safe('Rocket DSA', run_rocket_dsa, s, _tkey='rocket_dsa')
    else:
        results['rocket_dram_dsa'] = 'SKIPPED'

    try:
        run_parser(s)
    except Exception as e:
        _status(f'Parser fallo: {e}', 'fail')

    timings = _timings.get(qdf) if CRONOS_MODE else None
    log_path, overall, result_content = write_result_log(qdf, week, ult0, ifwi, results, LOG_DIR,
                                                         timings=timings, content=content)

    if overall == 'FAIL':
        _status(f'QDF fuseado {qdf}: FALLO — ver {log_path}', 'fail')
        _alert_popup_async(f'FCO FALLO — {qdf}',
                           f'Uno o mas contenidos fallaron.\nVer: {log_path}')
    else:
        _status(f'QDF fuseado {qdf}: PASS', 'ok')

    return log_path, overall, result_content


# ---------------------------------------------------------------------------
# Loop principal (modos 1, 3-fase-B y 4): señales SV + boot SVOS + tests
# ---------------------------------------------------------------------------

def _run_main_loop(s: SVOSSession, qdf_list: list, week: str, ult0: str, ifwi: str) -> list:
    """Ejecuta el loop de senales SV + boot SVOS + tests con retry. Retorna all_results."""
    all_results  = []
    retry_needed = []

    for i, item in enumerate(qdf_list):
        qdf  = item['qdf']
        ult0 = item['ult0']

        print(f'\n{"="*60}')
        _status(f'QDF {i+1}/{len(qdf_list)}: {qdf}', 'step')
        print(f'{"="*60}')

        try:
            sv_done = SIGNAL_DIR / f'{qdf}_sv_done.signal'
            _status(f'Esperando que SV termine fuse overwrite de {qdf}...', 'wait')
            t0_ow = time.time()
            wait_for_signal(sv_done)
            if CRONOS_MODE:
                _timings.setdefault(qdf, {})['overwrite_wait'] = time.time() - t0_ow
            _status(f'Fuse overwrite de {qdf} completado. Iniciando SVOS...', 'ok')

            t0_boot = time.time()
            boot_svos(s)
            setup_fco_dir(s, qdf, week)
            if CRONOS_MODE:
                _timings.setdefault(qdf, {})['boot'] = time.time() - t0_boot

            content = item.get('content')
            results = {}

            def _run_safe(name, fn, *args, _tkey=None):
                """Corre un test, captura cualquier fallo y lo reporta como FAIL."""
                t0 = time.time()
                try:
                    result = fn(*args)
                except Exception as e:
                    _status(f'{name} FALLO: {e}', 'fail')
                    logging.error(f'{name} fallo para {qdf}: {e}', exc_info=True)
                    result = 'FAIL'
                if CRONOS_MODE and _tkey:
                    _timings.setdefault(qdf, {})[_tkey] = time.time() - t0
                return result

            if _should_run(content, 'supercollider'):
                results['supercollider'] = _run_safe('SuperCollider', run_supercollider, s,
                                                     _tkey='supercollider')
            else:
                results['supercollider'] = 'SKIPPED'

            if _should_run(content, 'rocket'):
                rocket_res = _run_safe('Rocket cpu/iax', run_rocket, s, _tkey='rocket_cpu_iax')
                if isinstance(rocket_res, dict):
                    results.update(rocket_res)
                else:
                    for _, label in ROCKET_CMDS:
                        results[label] = 'FAIL'
            else:
                for _, label in ROCKET_CMDS:
                    results[label] = 'SKIPPED'

            results['memicals'] = (_run_safe('Memicals', run_memicals, s, _tkey='memicals')
                                   if _should_run(content, 'memicals') else 'SKIPPED')
            results['mlc']      = (_run_safe('MLC', run_mlc, s, _tkey='mlc')
                                   if _should_run(content, 'mlc')      else 'SKIPPED')
            results['solar']    = (_run_safe('Solar', run_solar, s, _tkey='solar')
                                   if _should_run(content, 'solar')    else 'SKIPPED')

            if _should_run(content, 'rocket'):
                results['rocket_dram_dsa'] = _run_safe('Rocket DSA', run_rocket_dsa, s,
                                                       _tkey='rocket_dsa')
            else:
                results['rocket_dram_dsa'] = 'SKIPPED'

            try:
                run_parser(s)
            except Exception as e:
                _status(f'Parser fallo: {e}', 'fail')

            log_path, overall, result_content = write_result_log(qdf, week, ult0, ifwi, results, LOG_DIR,
                                                  timings=_timings.get(qdf) if CRONOS_MODE else None,
                                                  content=content)

            try:
                summary_lines = [f'FCO WW{week} {qdf} - Overall: {overall}'] + \
                                [f'{k}: {v}' for k, v in results.items()]
                s.send(f'echo "{chr(10).join(summary_lines)}" > fco_result.txt')
                s.read_until(SVOS_PROMPT, timeout=CMD_TIMEOUT)
            except Exception as e:
                _status(f'No se pudo escribir fco_result.txt en SVOS: {e}', 'fail')

            if overall == 'FAIL':
                _status(f'QDF {qdf}: FALLO - ver {log_path}', 'fail')
                _alert_popup_async(f'FCO FALLO — {qdf}',
                                   f'Uno o mas contenidos fallaron.\nVer: {log_path}')
            else:
                _status(f'QDF {qdf}: PASS', 'ok')

            timing_total = sum(_timings.get(qdf, {}).values()) if CRONOS_MODE else None
            entry = {'qdf': qdf, 'overall': overall, 'log': str(log_path),
                     'result_content': result_content}
            if timing_total is not None:
                entry['timing_total'] = timing_total
            all_results.append(entry)

        except (MountsvTimeoutError, BiosTimeoutError) as e:
            reason = type(e).__name__
            _status(f'QDF {qdf}: {reason} — se agregara a cola de retry', 'fail')
            logging.error(f'{reason} en QDF {qdf}: {e}')
            _alert_popup_async(f'{reason} — {qdf}',
                               f'Se reintentara al final con power cycle.\n{e}')
            all_results.append({'qdf': qdf, 'overall': reason, 'log': str(e)})
            retry_needed.append({'qdf': qdf, 'ult0': ult0,
                                 'soc': item.get('soc', 'x4'),
                                 'extra_args': item.get('extra_args'),
                                 'content': item.get('content'),
                                 'reason': reason})

        except Exception as e:
            _status(f'ERROR en QDF {qdf}: {e}', 'fail')
            logging.error(f'Error inesperado en QDF {qdf}: {e}', exc_info=True)
            _alert_popup_async(f'ERROR en QDF {qdf}', str(e))
            all_results.append({'qdf': qdf, 'overall': 'ERROR', 'log': str(e)})
            _status('Continuando con el siguiente QDF...', 'step')

        finally:
            svos_done = SIGNAL_DIR / f'{qdf}_svos_done.signal'
            try:
                svos_done.write_text('done\n')
                _status(f'Senal escrita para SV: {svos_done.name}', 'info')
            except Exception as e:
                _status(f'No se pudo escribir senal SV: {e}', 'fail')

    # ---- FASE 2: Retry QDFs con BIOS/MOUNTSV timeout ----
    if retry_needed:
        print(f'\n{"="*60}')
        _status(f'FASE 2 — Retry de {len(retry_needed)} QDF(s): '
                f'{[r["qdf"] for r in retry_needed]}', 'step')
        print(f'{"="*60}')

        retry_json = SIGNAL_DIR / 'retry_needed.json'
        retry_json.write_text(json.dumps(retry_needed, indent=2), encoding='utf-8')
        (SIGNAL_DIR / 'retry_needed.signal').write_text('retry\n')
        _status('Senal retry_needed enviada a SV. Esperando power cycle...', 'wait')
        wait_for_signal(SIGNAL_DIR / 'retry_ready.signal')
        _status('Power cycle completado. Iniciando retry...', 'ok')

        for retry_item in retry_needed:
            qdf  = retry_item['qdf']
            ult0 = retry_item['ult0']
            print(f'\n{"="*60}')
            _status(f'RETRY — QDF {qdf} (razon: {retry_item["reason"]})', 'step')
            print(f'{"="*60}')

            try:
                wait_for_signal(SIGNAL_DIR / f'{qdf}_retry_sv_done.signal')
                _status(f'Overwrite retry de {qdf} completado. Booteando SVOS...', 'ok')

                t0_boot_r = time.time()
                boot_svos(s)
                setup_fco_dir(s, qdf, week)
                if CRONOS_MODE:
                    _timings.setdefault(qdf, {})['boot'] = time.time() - t0_boot_r

                content_r = retry_item.get('content')
                results = {}

                def _run_safe_r(name, fn, *args, _tkey=None):
                    t0 = time.time()
                    try:
                        result = fn(*args)
                    except Exception as e:
                        _status(f'{name} FALLO: {e}', 'fail')
                        logging.error(f'[RETRY] {name} fallo para {qdf}: {e}', exc_info=True)
                        result = 'FAIL'
                    if CRONOS_MODE and _tkey:
                        _timings.setdefault(qdf, {})[_tkey] = time.time() - t0
                    return result

                if _should_run(content_r, 'supercollider'):
                    results['supercollider'] = _run_safe_r('SuperCollider', run_supercollider, s,
                                                           _tkey='supercollider')
                else:
                    results['supercollider'] = 'SKIPPED'

                if _should_run(content_r, 'rocket'):
                    rocket_res = _run_safe_r('Rocket cpu/iax', run_rocket, s, _tkey='rocket_cpu_iax')
                    if isinstance(rocket_res, dict):
                        results.update(rocket_res)
                    else:
                        for _, label in ROCKET_CMDS:
                            results[label] = 'FAIL'
                else:
                    for _, label in ROCKET_CMDS:
                        results[label] = 'SKIPPED'

                results['memicals'] = (_run_safe_r('Memicals', run_memicals, s, _tkey='memicals')
                                       if _should_run(content_r, 'memicals') else 'SKIPPED')
                results['mlc']      = (_run_safe_r('MLC', run_mlc, s, _tkey='mlc')
                                       if _should_run(content_r, 'mlc')      else 'SKIPPED')
                results['solar']    = (_run_safe_r('Solar', run_solar, s, _tkey='solar')
                                       if _should_run(content_r, 'solar')    else 'SKIPPED')

                if _should_run(content_r, 'rocket'):
                    results['rocket_dram_dsa'] = _run_safe_r('Rocket DSA', run_rocket_dsa, s,
                                                             _tkey='rocket_dsa')
                else:
                    results['rocket_dram_dsa'] = 'SKIPPED'

                try:
                    run_parser(s)
                except Exception as e:
                    _status(f'Parser fallo en retry: {e}', 'fail')

                log_path, overall, result_content = write_result_log(qdf, week, ult0, ifwi, results, LOG_DIR,
                                                     timings=_timings.get(qdf) if CRONOS_MODE else None,
                                                     content=content_r)
                retry_overall = f'RETRY_{overall}'
                _status(f'RETRY QDF {qdf}: {retry_overall}', 'ok' if overall == 'PASS' else 'fail')
                if overall == 'FAIL':
                    _alert_popup_async(f'RETRY FALLO — {qdf}',
                                       f'Retry completado pero contenidos fallaron.\nVer: {log_path}')

                timing_total_r = sum(_timings.get(qdf, {}).values()) if CRONOS_MODE else None
                for r in all_results:
                    if r['qdf'] == qdf:
                        r['overall'] = retry_overall
                        r['log'] = str(log_path)
                        r['result_content'] = result_content
                        if timing_total_r is not None:
                            r['timing_total'] = timing_total_r
                        break

            except (MountsvTimeoutError, BiosTimeoutError) as e:
                _status(f'RETRY QDF {qdf} fallo nuevamente ({type(e).__name__}): {e}', 'fail')
                logging.error(f'[RETRY] {type(e).__name__} en QDF {qdf}: {e}')
                _alert_popup_async(f'RETRY FAIL — {qdf}', f'Fallo en segundo intento.\n{e}')
                for r in all_results:
                    if r['qdf'] == qdf:
                        r['overall'] = 'RETRY_FAIL'
                        break

            except Exception as e:
                _status(f'RETRY QDF {qdf} error inesperado: {e}', 'fail')
                logging.error(f'[RETRY] Error en QDF {qdf}: {e}', exc_info=True)
                _alert_popup_async(f'RETRY ERROR — {qdf}', str(e))
                for r in all_results:
                    if r['qdf'] == qdf:
                        r['overall'] = 'RETRY_FAIL'
                        break

            finally:
                try:
                    (SIGNAL_DIR / f'{qdf}_retry_svos_done.signal').write_text('done\n')
                    _status(f'Senal retry_svos_done escrita para {qdf}', 'info')
                except Exception as e:
                    _status(f'No se pudo escribir retry signal: {e}', 'fail')

    return all_results


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(description='FCO SVOS Serial Automation')
    parser.add_argument('--config', default=str(QDF_LIST_FILE),
                        help='Path al JSON con lista de QDFs')
    args = parser.parse_args()

    # ---- Setup ----
    _update_readme()
    ts = datetime.datetime.now().strftime('%Y%m%d_%H%M%S')
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    setup_logging(LOG_DIR / f'svos_automation_{ts}.log')
    SIGNAL_DIR.mkdir(parents=True, exist_ok=True)

    logging.info('=== FCO SVOS Automation ===')

    global TEST_MODE

    # ---- Modo de ejecucion ----
    mode = _ask_mode()

    # ---- COM port y semana ----
    com_port, week = _ask_com_week()

    # Leer IFWI una sola vez (es el mismo para todos los QDFs)
    ifwi = get_ifwi_version()
    logging.info(f'IFWI detectado: {ifwi}')

    all_results   = []
    summary_ult0  = 'N/A'
    s             = None

    try:
        if mode in (1, 4):
            qdfs, ult0, soc, extra_args = _ask_qdf_params()
            if not qdfs:
                print('\n[!!] ERROR: no ingresaste ningun QDF.')
                input('\nPresiona ENTER para cerrar...')
                sys.exit(1)

            qdf_list = [{'qdf': q, 'ult0': ult0, 'soc': soc, 'extra_args': extra_args,
                         'fused_unit': (mode == 4)}
                        for q in qdfs]
            with open(QDF_LIST_FILE, 'w') as f:
                json.dump(qdf_list, f, indent=2)

            print()
            print('  Resumen de QDFs a procesar:')
            for item in qdf_list:
                extra_str = f"  extra_args={item['extra_args']}" if item['extra_args'] else ''
                print(f'    {item["qdf"]:<12}  ULT={item["ult0"]}  SOC={item["soc"]}{extra_str}')
            print()
            _ask_content_config(qdf_list)
            with open(QDF_LIST_FILE, 'w') as f:
                json.dump(qdf_list, f, indent=2)

            logging.info(f'COM: {com_port} | Modo: {mode} | Semana: WW{week} | '
                         f'ULT: {ult0} | SOC: {soc} | QDFs: {qdfs}')

            _clean_signals(qdf_list)
            logging.info('Signals anteriores eliminadas.')

            try:
                s = SVOSSession(com_port)
                logging.info(f'Puerto {com_port} abierto a {BAUDRATE} baud.')
            except serial.SerialException as e:
                logging.error(f'No se pudo abrir {com_port}: {e}')
                input('\nPresiona ENTER para cerrar...')
                sys.exit(1)

            if mode == 4:
                print()
                _status('Modo 4: Unidad fuseada — ignorando boot actual.', 'info')
                _status('        Esperando que SV inicie el overwrite...', 'info')

            summary_ult0 = ult0
            all_results  = _run_main_loop(s, qdf_list, week, ult0, ifwi)

        elif mode == 2:
            qdfs, ult0, soc, extra_args = _ask_qdf_params('(QDF fuseado)')
            if not qdfs:
                print('\n[!!] ERROR: no ingresaste ningun QDF.')
                input('\nPresiona ENTER para cerrar...')
                sys.exit(1)

            qdf = qdfs[0]
            _fused_list = [{'qdf': qdf}]
            _ask_content_config(_fused_list)
            fused_content = _fused_list[0].get('content')
            logging.info(f'COM: {com_port} | Modo: 2 | Semana: WW{week} | '
                         f'ULT: {ult0} | QDF fuseado: {qdf}')

            try:
                s = SVOSSession(com_port)
                logging.info(f'Puerto {com_port} abierto a {BAUDRATE} baud.')
            except serial.SerialException as e:
                logging.error(f'No se pudo abrir {com_port}: {e}')
                input('\nPresiona ENTER para cerrar...')
                sys.exit(1)

            print(f'\n{"="*60}')
            _status(f'Modo 2 — Testeando QDF fuseado: {qdf}', 'step')
            print(f'{"="*60}')

            log_path, overall, result_content = run_fused_test(s, qdf, ult0, week, ifwi,
                                                               content=fused_content)
            summary_ult0 = ult0
            all_results.append({'qdf': qdf, 'overall': overall, 'log': str(log_path),
                                 'result_content': result_content})

        elif mode == 3:
            # FASE A: QDF fuseado
            print('\n[Fase A] Ingresa el QDF fuseado a testear primero:')
            qdfs_f, ult0_f, soc_f, _ = _ask_qdf_params('(QDF fuseado)')
            if not qdfs_f:
                print('\n[!!] ERROR: no ingresaste ningun QDF fuseado.')
                input('\nPresiona ENTER para cerrar...')
                sys.exit(1)
            qdf_fused = qdfs_f[0]

            # Configuracion de contenido para QDF fuseado
            print('\n[Contenido Fase A] Configura los tests para el QDF fuseado:')
            _fused_list_m3 = [{'qdf': qdf_fused}]
            _ask_content_config(_fused_list_m3)
            fused_content_m3 = _fused_list_m3[0].get('content')

            # FASE B: QDFs a overwritear
            print('\n[Fase B] Ingresa los QDFs adicionales a overwritear despues del test fuseado:')
            qdfs_ow, ult0_ow, soc_ow, extra_ow = _ask_qdf_params('(QDFs a overwritear)')
            if not qdfs_ow:
                print('\n[!!] ERROR: no ingresaste ningun QDF a overwritear.')
                input('\nPresiona ENTER para cerrar...')
                sys.exit(1)

            qdf_list = [{'qdf': q, 'ult0': ult0_ow, 'soc': soc_ow, 'extra_args': extra_ow,
                         'fused_unit': True}
                        for q in qdfs_ow]

            # Configuracion de contenido para QDFs a overwritear
            print('\n[Contenido Fase B] Configura los tests para los QDFs a overwritear:')
            _ask_content_config(qdf_list)

            logging.info(f'COM: {com_port} | Modo: 3 | Semana: WW{week} | '
                         f'QDF fuseado: {qdf_fused} | QDFs overwrite: {qdfs_ow}')

            try:
                s = SVOSSession(com_port)
                logging.info(f'Puerto {com_port} abierto a {BAUDRATE} baud.')
            except serial.SerialException as e:
                logging.error(f'No se pudo abrir {com_port}: {e}')
                input('\nPresiona ENTER para cerrar...')
                sys.exit(1)

            # FASE A: testear QDF fuseado
            print(f'\n{"="*60}')
            _status(f'FASE A — Testeando QDF fuseado: {qdf_fused}', 'step')
            print(f'{"="*60}')

            log_path_f, overall_f, result_content_f = run_fused_test(s, qdf_fused, ult0_f, week, ifwi,
                                                                      content=fused_content_m3)
            all_results.append({'qdf': qdf_fused, 'overall': overall_f, 'log': str(log_path_f),
                                 'result_content': result_content_f})

            # Transicion a FASE B
            print(f'\n{"="*60}')
            print('  FASE A completada. Inicia sv_automation ahora.')
            print('  Cuando sv_automation este listo, presiona ENTER para continuar...')
            print(f'{"="*60}')
            input()

            # Guardar qdf_list.json y limpiar signals para FASE B
            with open(QDF_LIST_FILE, 'w') as f:
                json.dump(qdf_list, f, indent=2)
            _clean_signals(qdf_list)
            logging.info('Signals anteriores eliminadas (inicio FASE B).')

            print(f'\n{"="*60}')
            _status(f'FASE B — Overwrite + test de {len(qdf_list)} QDF(s)', 'step')
            print(f'{"="*60}')

            summary_ult0 = ult0_ow
            loop_results = _run_main_loop(s, qdf_list, week, ult0_ow, ifwi)
            all_results.extend(loop_results)

    except KeyboardInterrupt:
        logging.warning('Interrumpido por el usuario.')
    except Exception as e:
        logging.error(f'Error inesperado: {e}', exc_info=True)
        print(f'\n[!!] ERROR inesperado: {e}')
    finally:
        if s is not None:
            try:
                s.close()
                logging.info('Puerto serial cerrado.')
            except Exception:
                pass

    # ---- Summary file de todos los QDFs ----
    if all_results:
        try:
            summary_path = write_summary_log(week, summary_ult0, ifwi, all_results, LOG_DIR)
            _status(f'Summary guardado: {summary_path.name}', 'ok')
        except Exception as e:
            _status(f'No se pudo escribir summary: {e}', 'fail')

    # ---- Resumen final ----
    print('\n' + '=' * 60)
    print('  RESUMEN FINAL')
    print('=' * 60)
    for r in all_results:
        ov = r['overall']
        if ov == 'PASS':
            tag = '[PASS]       '
        elif ov == 'RETRY_PASS':
            tag = '[RETRY PASS] '
        elif ov in ('RETRY_FAIL', 'RETRY_ERROR'):
            tag = '[RETRY FAIL] '
        else:
            tag = '[FAIL]       '
        print(f"  {r['qdf']:<12} {ov:<20} {tag}")
    print('=' * 60)
    input('\nPresiona ENTER para cerrar...')


if __name__ == '__main__':
    _self_update()
    try:
        main()
    except Exception as e:
        print(f'\n[!!] ERROR al iniciar: {e}')
        import traceback
        traceback.print_exc()
        input('\nPresiona ENTER para cerrar...')

