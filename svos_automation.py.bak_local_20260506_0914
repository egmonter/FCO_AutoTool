    ult0 = input('ULT (mismo para todos los QDFs)            : ').strip()

    while True:
        soc = input('SOC (x4 / x1)                              : ').strip().lower()
        if soc in ('x4', 'x1'):
            break
        print('  [!!] Opcion invalida, escribe x4 o x1.')

    extra_args = None
    print()
    print("Extra args opcionales (ej: {'disable_axon': True, 'key': False})")
    print("  Deja en blanco si no necesitas.")
    while True:
        raw_extra = input('Extra args                                 : ').strip()
