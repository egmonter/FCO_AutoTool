def _pause(msg: str = 'Presiona cualquier tecla para continuar...'):
    """Pausa la ejecucion solo en TEST_MODE."""
    if not TEST_MODE:
        return
    print(f'\n  [PAUSA] {msg}', flush=True)
    if sys.platform == 'win32':
        import msvcrt
        msvcrt.getch()
    else:
        import tty, termios
        fd = sys.stdin.fileno()
        old = termios.tcgetattr(fd)
        try:
            tty.setraw(fd)
            sys.stdin.read(1)
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)
    print()


def _strip_ansi(data: bytes) -> str:
    """Elimina codigos de escape ANSI del output del BIOS/terminal."""
    text = data.decode('utf-8', errors='replace')
    return re.sub(r'\x1b\[[0-9;?]*[A-Za-z]|\x1b[()][A-Z0-9]|\x1b=|\x1b>', '', text)


# Patron de color EDK2 para el item RESALTADO (blanco sobre negro = seleccionado)
# El BIOS envia ESC[37m ESC[40m justo antes del texto del item activo
_HIGHLIGHT_RE = re.compile(
    rb'\x1b\[(?:0m\x1b\[)?37m\x1b\[40m'   # secuencia de color resaltado
    rb'((?:\x1b\[\d+;\d+H)?[^\x1b\r\n]{1,80})'  # texto (con posible cursor-pos)
)
_CURSOR_POS_RE = re.compile(rb'\x1b\[\d+;\d+H')


def _highlighted_items(raw: bytes) -> list:
    """
    Retorna lista de textos que estan actualmente RESALTADOS en el menu BIOS.
    EDK2 usa ESC[37mESC[40m (blanco sobre negro) para el item seleccionado.
    """
    results = []
    for m in _HIGHLIGHT_RE.finditer(raw):
        chunk = _CURSOR_POS_RE.sub(b'', m.group(1))
        text = chunk.decode('utf-8', errors='replace').strip()
        if text:
            results.append(text)
    return results


