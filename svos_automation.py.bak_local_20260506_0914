class FCOStepError(Exception):
    """Error en un paso especifico del workflow. Lleva descripcion amigable."""
    pass

class MountsvTimeoutError(FCOStepError):
    """mountsv no respondio en el tiempo esperado — retryable via power cycle."""
    pass

class BiosTimeoutError(FCOStepError):
    """Pantalla BIOS no aparecio en el tiempo esperado — retryable via power cycle."""
    pass


@contextlib.contextmanager
def _guard(step_desc: str):
    """
    Envuelve un bloque de codigo y convierte TimeoutError / SerialException
    en FCOStepError con un mensaje descriptivo del paso que fallo.
    """
    try:
        yield
    except TimeoutError:
        raise FCOStepError(f'TIMEOUT esperando: {step_desc}')
    except serial.SerialException as e:
        raise FCOStepError(f'Error serial en "{step_desc}": {e}')


def _alert_popup(title: str, msg: str):
    """Popup de Windows bloqueante + imprime en consola."""
    print(f'\n[!!] {title}\n     {msg}\n', flush=True)
    try:
        ctypes.windll.user32.MessageBoxW(0, msg, title, 0x10)
    except Exception:
        pass


def _alert_popup_async(title: str, msg: str):
    """Popup informativo NO bloqueante (hilo separado). La ejecucion continua inmediatamente."""
    import threading
    print(f'\n[!] {title}: {msg}', flush=True)
    def _show():
        try:
            ctypes.windll.user32.MessageBoxW(0, msg, title, 0x40)
        except Exception:
            pass
    threading.Thread(target=_show, daemon=True).start()

