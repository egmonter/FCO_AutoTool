            break
        try:
            import ast
            parsed = ast.literal_eval(raw_extra)
            if not isinstance(parsed, dict):
                raise ValueError('Debe ser un dict')
            extra_args = parsed
            break
        except Exception:
            print("  [!!] Formato invalido. Usa formato Python dict, ej: {'disable_axon': True}")

    return qdfs, ult0, soc, extra_args


