# Serial helper
# ---------------------------------------------------------------------------

class SVOSSession:
    """Wraps pyserial con helpers de read_until / send."""

    def __init__(self, port, baudrate=BAUDRATE):
        self.port    = port
        self.ser     = serial.Serial(port, baudrate, timeout=0.1)
        self.log     = logging.getLogger('serial')
        self.buf     = b''

    def send_arrow_down(self):
        """Envia la tecla flecha abajo (escape ANSI)."""
        self.ser.write(b'\x1b[B')

    def send_arrow_up(self):
        """Envia la tecla flecha arriba (escape ANSI)."""
        self.ser.write(b'\x1b[A')

    def read_screen(self, wait=0.4):
        """
        Lee lo que haya en el buffer tras una pausa.
        Retorna (raw_bytes, texto_limpio).
        """
        time.sleep(wait)
        raw = b''
        while True:
            chunk = self.ser.read(1024)
            if not chunk:
                break
            raw += chunk
        self.buf += raw
        self._print(raw)
        return raw, _strip_ansi(raw)

    # ---- escritura ----

    def send(self, cmd: str):
        self.log.info(f'>>> {cmd!r}')
        self.ser.write((cmd + '\r\n').encode())

    def send_slow(self, cmd: str, char_delay: float = 0.05):
        """
        Envia el comando caracter por caracter con un delay entre cada uno.
        Usar cuando el terminal no puede procesar la entrada rapida (ej: EFI Shell).
        """
        self.log.info(f'>>> (slow) {cmd!r}')
        for ch in cmd:
            self.ser.write(ch.encode())
            time.sleep(char_delay)
        time.sleep(0.1)  # pausa antes del Enter
        self.ser.write(b'\r\n')

    def send_enter(self):
        self.ser.write(b'\r\n')

    def send_escape(self):
        """Envia la tecla ESC para volver al menu anterior en el BIOS."""
        self.ser.write(b'\x1b')

    def send_key(self, raw: bytes):
        self.ser.write(raw)

    # ---- lectura ----

    def read_until(self, expected, timeout=CMD_TIMEOUT) -> bytes:
        """Lee hasta encontrar `expected`. timeout=None espera indefinidamente."""
        if isinstance(expected, str):
            expected = expected.encode()
        deadline = (time.time() + timeout) if timeout is not None else None
        while True:
            chunk = self.ser.read(512)
            if chunk:
                self.buf += chunk
                self._print(chunk)
            if expected in self.buf:
                out, self.buf = self.buf, b''
                return out
            if deadline and time.time() > deadline:
                raise TimeoutError(f'Timeout ({timeout}s) esperando: {expected!r}')
            time.sleep(0.05)

    def read_until_any(self, patterns, timeout=CMD_TIMEOUT):
        """Lee hasta encontrar cualquiera de los patrones. timeout=None espera indefinidamente."""
        enc = [p.encode() if isinstance(p, str) else p for p in patterns]
        deadline = (time.time() + timeout) if timeout is not None else None
        while True:
            chunk = self.ser.read(512)
            if chunk:
                self.buf += chunk
                self._print(chunk)
            for p in enc:
                if p in self.buf:
                    out, self.buf = self.buf, b''
                    return p, out
            if deadline and time.time() > deadline:
                raise TimeoutError(f'Timeout ({timeout}s) esperando patrones: {patterns}')
            time.sleep(0.05)

    def flush(self):
        """Vacia el buffer de lectura."""
        time.sleep(0.3)
        self.ser.reset_input_buffer()
        self.buf = b''

    def close(self):
        self.ser.close()

    @staticmethod
    def _print(data: bytes):
        try:
            print(data.decode('utf-8', errors='replace'), end='', flush=True)
        except Exception:
            pass


